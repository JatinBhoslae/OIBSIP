{
  "name": "pizzahub-backend",
  "version": "1.0.0",
  "description": "PizzaHub Backend API",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "start": "node src/app.js",
    "start:prod": "NODE_ENV=production node src/app.js",
    "dev": "nodemon src/app.js",
    "seed": "node src/utils/seeder.js",
    "health-check": "node -e \"fetch('http://localhost:' + (process.env.PORT || 5001) + '/api/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.1",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.13",
    "razorpay": "^2.9.2",
    "slugify": "^1.6.9",
    "socket.io": "^4.7.5",
    "twilio": "^6.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
